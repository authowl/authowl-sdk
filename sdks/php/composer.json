{
  "name": "authowl/authowl",
  "description": "Server-side token verification and webhook helpers for AuthOwl, the multi-tenant auth SaaS.",
  "type": "library",
  "license": "MIT",
  "keywords": ["authentication", "auth", "authowl", "jwt", "oauth", "sdk"],
  "homepage": "https://authowl.dev",
  "require": {
    "php": ">=8.1",
    "ext-openssl": "*",
    "ext-json": "*",
    "ext-hash": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0"
  },
  "autoload": {
    "psr-4": {
      "AuthOwl\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "AuthOwl\\Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
    "test": "phpunit"
  }
}
