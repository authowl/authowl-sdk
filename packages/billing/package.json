{
  "name": "@authowl/billing",
  "private": true,
  "version": "0.0.0",
  "description": "Feature entitlements for apps that bill through AuthOwl's Billing module: has(), check() and fail-closed snapshots.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authowl/authowl-sdk.git",
    "directory": "packages/billing"
  },
  "homepage": "https://authowl.dev",
  "keywords": [
    "authowl",
    "billing",
    "entitlements",
    "feature-gating",
    "subscriptions"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts src/react.tsx src/server.ts --format esm,cjs --dts --clean --external @authowl/core,@authowl/core/server,@authowl/react,@authowl/next/server,react,react/jsx-runtime && node ../../scripts/gen-notices.mjs src/index.ts src/react.tsx src/server.ts",
    "dev": "tsup src/index.ts src/react.tsx src/server.ts --format esm,cjs --dts --watch --external @authowl/core,@authowl/core/server,@authowl/react,@authowl/next/server,react,react/jsx-runtime",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/release/direct-publish-guard.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@authowl/core": "workspace:*"
  },
  "peerDependencies": {
    "@authowl/next": ">=0.4.7 <1.0.0",
    "@authowl/react": ">=1.0.1 <2.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@authowl/next": {
      "optional": true
    },
    "@authowl/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@authowl/next": "workspace:*",
    "@authowl/react": "workspace:*",
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "26.1.0",
    "next": "^16.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
