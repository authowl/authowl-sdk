{
  "name": "@authowl/billing",
  "version": "0.1.0",
  "description": "Entitlements, pricing, checkout and customer portal components for AuthOwl Billing.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authowl/authowl-sdk.git",
    "directory": "packages/billing"
  },
  "homepage": "https://authowl.dev",
  "keywords": [
    "authowl",
    "billing",
    "entitlements",
    "feature-gating",
    "subscriptions"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./react/commerce": {
      "import": {
        "types": "./dist/react-commerce.d.ts",
        "default": "./dist/react-commerce.js"
      },
      "require": {
        "types": "./dist/react-commerce.d.cts",
        "default": "./dist/react-commerce.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup --config tsup.config.ts && node scripts/build-styles.mjs && node ../../scripts/gen-notices.mjs src/index.ts src/react-base.tsx src/react-commerce.tsx src/server.ts",
    "dev": "tsup --config tsup.config.ts --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/release/direct-publish-guard.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@authowl/core": "workspace:*"
  },
  "peerDependencies": {
    "@authowl/next": ">=0.4.7 <1.0.0",
    "@authowl/react": ">=1.0.1 <2.0.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "@authowl/next": {
      "optional": true
    },
    "@authowl/react": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@authowl/next": "workspace:*",
    "@authowl/react": "workspace:*",
    "@testing-library/react": "16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "jsdom": "30.1.3",
    "next": "^16.4.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^9.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
