{
  "name": "@authowl/core",
  "version": "0.24.0",
  "description": "Framework-agnostic client for AuthOwl, the multi-tenant auth SaaS.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authowl/authowl-sdk.git",
    "directory": "packages/auth-core"
  },
  "homepage": "https://authowl.dev",
  "keywords": [
    "authentication",
    "auth",
    "authowl",
    "oauth",
    "passkey",
    "sdk"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./native": {
      "import": {
        "types": "./dist/native.d.ts",
        "default": "./dist/native.js"
      },
      "require": {
        "types": "./dist/native.d.cts",
        "default": "./dist/native.cjs"
      }
    },
    "./i18n": {
      "import": {
        "types": "./dist/messages.d.ts",
        "default": "./dist/messages.js"
      },
      "require": {
        "types": "./dist/messages.d.cts",
        "default": "./dist/messages.cjs"
      }
    },
    "./privacy": {
      "import": {
        "types": "./dist/privacy.d.ts",
        "default": "./dist/privacy.js"
      },
      "require": {
        "types": "./dist/privacy.d.cts",
        "default": "./dist/privacy.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/gen-notices.mjs src/index.ts src/server.ts src/native.ts src/messages.ts src/privacy.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node ../../scripts/release/direct-publish-guard.mjs"
  },
  "dependencies": {
    "@akedly/shield": "1.1.0"
  },
  "devDependencies": {
    "jsdom": "26.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
