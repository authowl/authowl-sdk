{
  "name": "@authowl/react",
  "version": "0.23.0",
  "description": "React provider, hooks, and drop-in components for AuthOwl, the multi-tenant auth SaaS.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authowl/authowl-sdk.git",
    "directory": "packages/auth-react"
  },
  "homepage": "https://authowl.dev",
  "keywords": [
    "authentication",
    "auth",
    "authowl",
    "react",
    "oauth",
    "passkey",
    "components",
    "hooks"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "dist/styles.css",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean --external react,react-dom && cp src/styles.css dist/styles.css && node ../../scripts/gen-notices.mjs src/index.ts",
    "dev": "tsup src/index.ts --format esm,cjs --dts --watch --external react,react-dom",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node ../../scripts/release/direct-publish-guard.mjs"
  },
  "dependencies": {
    "@authowl/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "26.1.0",
    "qrcode-generator": "^2.0.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.10"
  }
}
