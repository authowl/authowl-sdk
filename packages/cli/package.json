{
  "name": "authowl",
  "version": "0.3.9",
  "description": "AuthOwl CLI for browser login and safe application detection.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authowl/authowl-sdk.git",
    "directory": "packages/cli"
  },
  "homepage": "https://authowl.dev",
  "keywords": [
    "authentication",
    "auth",
    "authowl",
    "cli",
    "nextjs",
    "vite"
  ],
  "type": "module",
  "sideEffects": false,
  "bin": {
    "authowl": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/gen-notices.mjs src/cli.ts",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "node ../../scripts/release/direct-publish-guard.mjs"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "csv-parse": "7.0.2",
    "stream-json": "3.5.0"
  }
}
