{
  "name": "@authowl/next",
  "version": "0.4.0",
  "description": "Next.js (App Router) server helpers for AuthOwl, the multi-tenant auth SaaS.",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/authowl/authowl-sdk.git",
    "directory": "packages/auth-next"
  },
  "homepage": "https://authowl.dev",
  "keywords": [
    "authentication",
    "auth",
    "authowl",
    "nextjs",
    "next",
    "app-router",
    "sso"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./client": {
      "import": {
        "types": "./dist/client.d.ts",
        "default": "./dist/client.js"
      },
      "require": {
        "types": "./dist/client.d.cts",
        "default": "./dist/client.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./dist/server.d.ts",
        "default": "./dist/server.js"
      },
      "require": {
        "types": "./dist/server.d.cts",
        "default": "./dist/server.cjs"
      }
    },
    "./middleware": {
      "import": {
        "types": "./dist/middleware.d.ts",
        "default": "./dist/middleware.js"
      },
      "require": {
        "types": "./dist/middleware.d.cts",
        "default": "./dist/middleware.cjs"
      }
    }
  },
  "files": [
    "dist",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup src/client.ts src/server.ts src/middleware.ts --format esm,cjs --dts --clean --external next && node ../../scripts/gen-notices.mjs src/client.ts src/server.ts src/middleware.ts",
    "dev": "tsup src/client.ts src/server.ts src/middleware.ts --format esm,cjs --dts --watch --external next",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "node ../../scripts/release/direct-publish-guard.mjs",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@authowl/core": "workspace:*"
  },
  "peerDependencies": {
    "next": ">=14"
  },
  "devDependencies": {
    "next": "^16.3.3",
    "tsup": "^8.3.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11"
  }
}
